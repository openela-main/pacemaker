diff --git a/include/crm/cluster.h b/include/crm/cluster.h
index b61fd70..137684d 100644
--- a/include/crm/cluster.h
+++ b/include/crm/cluster.h
@@ -1,5 +1,5 @@
 /*
- * Copyright 2004-2023 the Pacemaker project contributors
