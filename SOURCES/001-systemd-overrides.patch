index 8981fc4c8b7..8cd6665cb69 100644
--- a/lib/services/systemd.c
+++ b/lib/services/systemd.c
@@ -820,7 +820,20 @@ create_world_readable(const char *filename)
     return fp;
 }
 
-static void
