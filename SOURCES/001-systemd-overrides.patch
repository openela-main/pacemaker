+        crm_err("Could not create systemd override directory %s: %s",
+                override_dir, pcmk_rc_str(rc));
     }
     free(override_dir);
+    return rc;
 }
 
 static char *
@@ -841,53 +855,83 @@ get_override_filename(const char *agent)
                              "/%s.service.d/50-pacemaker.conf", agent);
 }
 
-static void
