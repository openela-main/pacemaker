-                            "class resources and used by Pacemaker's fence "
-                            "daemon, formerly known as stonithd");
-
-    gchar *s = pcmk__format_option_metadata("pacemaker-fenced", desc_short,
-                                            desc_long, fencer_options,
+                                "\"stonith\"-class resources");
